@model PadhaiHub.Models.Course
@{
    ViewData["Title"] = Model.Title;
}

<h1 class="h3">@Model.Title</h1>
<p class="text-muted">@Model.Category?.Name &middot; @Model.Level</p>

@if (!string.IsNullOrEmpty(Model.ImagePath))
{
    <img src="@Model.ImagePath" alt="@Model.Title" class="rounded mb-3" width="360" />
}

<p>@Model.Description</p>

<section class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="h5">Lessons</h2>
        <a class="btn btn-sm btn-primary"
           asp-controller="Lessons" asp-action="Create"
           asp-route-courseId="@Model.CourseId">+ Add lesson</a>
    </div>
    <ol>
        @foreach (var l in Model.Lessons.OrderBy(l => l.LessonOrder))
        {
            <li>
                @l.Title
                <a asp-controller="Lessons" asp-action="Edit" asp-route-id="@l.LessonId">Edit</a>
            </li>
        }
    </ol>
</section>

<section>
    <h2 class="h5">Quizzes</h2>
    <ul>
        @foreach (var q in Model.Quizzes)
        {
            <li>
                <a asp-controller="Quizzes" asp-action="Details" asp-route-id="@q.QuizId">@q.Title</a>
            </li>
        }
    </ul>
</section>

<a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>