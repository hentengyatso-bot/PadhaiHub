@model IEnumerable<PadhaiHub.Models.Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Courses</h1>
    <a class="btn btn-primary" asp-action="Create">+ New course</a>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Category</th>
            <th>Level</th>
            <th>Enrolments</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@(item.ImagePath ?? "/images/course-placeholder.png")"
                         alt=""
                         width="80"
                         height="50"
                         style="object-fit: cover;" />
                </td>
                <td>@item.Title</td>
                <td>@item.Category?.Name</td>
                <td>@item.Level</td>
                <td>@item.Enrollments.Count</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.CourseId">Details</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.CourseId">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.CourseId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>