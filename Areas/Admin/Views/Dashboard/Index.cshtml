@model PadhaiHub.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <style>
        .stat-card {
            display: flex;
            align-items: center;
            gap: 1rem;
            border-radius: 0.75rem;
            padding: 1.25rem;
            border: 1px solid #e5e7eb;
            background: #fff;
            border-left: 5px solid var(--accent, #2563eb);
            height: 100%;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-bg, #eef2ff);
            color: var(--accent, #2563eb);
            flex-shrink: 0;
        }

        .stat-number {
            font-size: 1.75rem;
            font-weight: 700;
            line-height: 1;
        }

        .stat-label {
            color: #6b7280;
            font-size: 0.9rem;
        }

        .dash-card {
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            background: #fff;
            height: 100%;
        }

        .bar-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.65rem;
        }

        .bar-label {
            width: 170px;
            flex-shrink: 0;
        }

        .bar-track {
            flex: 1;
            background: #eef2ff;
            border-radius: 999px;
            height: 10px;
            overflow: hidden;
        }

        .bar-fill {
            background: #2563eb;
            height: 100%;
            border-radius: 999px;
        }

        .avatar-chip {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #e0e7ff;
            color: #3730a3;
            font-weight: 600;
            font-size: 0.8rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
    </style>
}

<div class="mb-4">
    <h1 class="h3 mb-0">Dashboard</h1>
    <p class="text-muted mb-0">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
</div>

<section class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--accent:#2563eb; --accent-bg:#dbeafe">
            <div class="stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
            <div>
                <div class="stat-number">@Model.TotalMembers</div>
                <div class="stat-label">Members</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--accent:#059669; --accent-bg:#d1fae5">
            <div class="stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
            </div>
            <div>
                <div class="stat-number">@Model.TotalCourses</div>
                <div class="stat-label">Courses</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--accent:#d97706; --accent-bg:#fef3c7">
            <div class="stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
            </div>
            <div>
                <div class="stat-number">@Model.TotalEnrollments</div>
                <div class="stat-label">Enrolments</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--accent:#db2777; --accent-bg:#fce7f3">
            <div class="stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <div>
                <div class="stat-number">@Model.TotalQuizAttempts</div>
                <div class="stat-label">Quiz attempts</div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4">
    <section class="col-lg-6">
        <div class="dash-card p-3">
            <h2 class="h6 text-uppercase text-muted mb-3">Most popular courses</h2>
            @{
                var maxEnrol = Model.PopularCourses.Any() ? Model.PopularCourses.Max(c => c.EnrollmentCount) : 0;
            }
            @if (!Model.PopularCourses.Any())
            {
                <p class="text-muted mb-0">No enrolments yet.</p>
            }
            @foreach (var c in Model.PopularCourses)
            {
                <div class="bar-row">
                    <span class="bar-label text-truncate">@c.Title</span>
                    <div class="bar-track">
                        <div class="bar-fill" style="width: @(maxEnrol > 0 ? c.EnrollmentCount * 100 / maxEnrol : 0)%"></div>
                    </div>
                    <span class="fw-semibold" style="width: 24px; text-align: right;">@c.EnrollmentCount</span>
                </div>
            }
        </div>
    </section>

    <section class="col-lg-6">
        <div class="dash-card p-3">
            <h2 class="h6 text-uppercase text-muted mb-3">Newest members</h2>
            @if (!Model.RecentMembers.Any())
            {
                <p class="text-muted mb-0">No members yet.</p>
            }
            <ul class="list-unstyled mb-0">
                @foreach (var u in Model.RecentMembers)
                {
                    <li class="d-flex align-items-center gap-2 py-2 border-bottom">
                        <span class="avatar-chip">@(u.FullName.Length > 0 ? u.FullName.Substring(0, 1).ToUpper() : "?")</span>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@u.FullName</div>
                            <div class="text-muted small">@u.Email</div>
                        </div>
                        <span class="text-muted small text-nowrap">@u.CreatedAt.ToString("dd MMM")</span>
                    </li>
                }
            </ul>
        </div>
    </section>
</div>