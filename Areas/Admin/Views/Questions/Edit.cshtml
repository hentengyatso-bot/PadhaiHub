@model PadhaiHub.Models.Question
@{
    ViewData["Title"] = "Edit question";
}

<h1 class="h3">Edit question in "@ViewData["QuizTitle"]"</h1>

<form asp-action="Edit" method="post" class="col-lg-8">
    <input type="hidden" asp-for="QuestionId" />
    <input type="hidden" asp-for="QuizId" />
    <partial name="_QuestionFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary"
       asp-controller="Quizzes" asp-action="Details"
       asp-route-id="@Model.QuizId">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}