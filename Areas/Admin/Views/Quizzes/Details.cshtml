@model PadhaiHub.Models.Quiz
@{
    ViewData["Title"] = Model.Title;
}

<h1 class="h3">@Model.Title</h1>
<p class="text-muted">Course: @Model.Course?.Title</p>
@if (!string.IsNullOrEmpty(Model.Description))
{
    <p>@Model.Description</p>
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Questions (@Model.Questions.Count)</h2>
    <a class="btn btn-primary btn-sm"
       asp-controller="Questions" asp-action="Create"
       asp-route-quizId="@Model.QuizId">+ Add question</a>
</div>

@if (!Model.Questions.Any())
{
    <p class="text-muted fst-italic">No questions yet. Click "Add question" to start.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Question</th>
                <th>A</th>
                <th>B</th>
                <th>C</th>
                <th>D</th>
                <th>Answer</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model.Questions.OrderBy(q => q.QuestionId))
            {
                <tr>
                    <td>@q.QuestionText</td>
                    <td>@q.OptionA</td>
                    <td>@q.OptionB</td>
                    <td>@q.OptionC</td>
                    <td>@q.OptionD</td>
                    <td><strong>@q.CorrectOption</strong></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-controller="Questions" asp-action="Edit"
                           asp-route-id="@q.QuestionId">Edit</a>
                        <form asp-controller="Questions" asp-action="Delete"
                              asp-route-id="@q.QuestionId" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this question?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.QuizId">Edit quiz</a> |
    <a asp-action="Index">Back to list</a>
</div>