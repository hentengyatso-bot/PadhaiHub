@model IEnumerable<PadhaiHub.Models.Quiz>
@{
    ViewData["Title"] = "Quizzes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Quizzes</h1>
    <a class="btn btn-primary" asp-action="Create">+ New quiz</a>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Course</th>
            <th>Title</th>
            <th>Questions</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Course?.Title</td>
                <td>@item.Title</td>
                <td>@item.Questions.Count</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.QuizId">Details</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.QuizId">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.QuizId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>