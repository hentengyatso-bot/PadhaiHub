@model List<PadhaiHub.Models.Course>
@{
    ViewData["Title"] = "Courses";
}

<h1 class="mb-3">All courses</h1>

@* GET form: search terms appear in the URL so results can be bookmarked *@
<form asp-action="Index" method="get" class="row g-2 mb-4" role="search">
    <div class="col-md-6">
        <input type="search" name="search" value="@ViewData["Search"]"
               class="form-control" placeholder="Search courses..."
               aria-label="Search courses" />
    </div>
    <div class="col-md-4">
        <select name="categoryId" asp-items="ViewBag.CategoryId"
                class="form-select" aria-label="Filter by category">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <p>No courses match your search.</p>
}

<div class="row g-4">
    @foreach (var course in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <article class="card h-100 course-card">
                <img src="@(course.ImagePath ?? "/images/course-placeholder.png")"
                     class="card-img-top"
                     alt="Cover image for @course.Title" />
                <div class="card-body">
                    <span class="badge bg-secondary">@course.Category?.Name</span>
                    <span class="badge bg-info text-dark">@course.Level</span>
                    <h2 class="h5 card-title mt-2">@course.Title</h2>
                    <p class="card-text">@course.Description</p>
                </div>
                <div class="card-footer bg-white border-0">
                    <a class="btn btn-outline-primary"
                       asp-action="Details"
                       asp-route-id="@course.CourseId">View course</a>
                </div>
            </article>
        </div>
    }
</div>