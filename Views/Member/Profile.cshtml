@model PadhaiHub.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}

<h1 class="h3 mb-3">My profile</h1>

<form asp-action="Profile" method="post" enctype="multipart/form-data" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3 text-center">
        <img id="photoPreview"
             src="@(Model.CurrentImagePath ?? "/images/avatar-placeholder.png")"
             alt="Profile photo"
             class="rounded-circle"
             width="120" height="120"
             style="object-fit: cover;" />
    </div>

    <div class="mb-3">
        <label asp-for="ProfilePhoto" class="form-label"></label>
        <input asp-for="ProfilePhoto" type="file" class="form-control"
               accept=".jpg,.jpeg,.png,.webp"
               data-preview="photoPreview" />
        <span asp-validation-for="ProfilePhoto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" readonly />
    </div>

    <button type="submit" class="btn btn-primary">Save changes</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/image-preview.js" asp-append-version="true"></script>
}