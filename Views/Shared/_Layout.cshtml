<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Online learning platform with courses, quizzes and discussions" />
    <title>@ViewData["Title"] - PadhaiHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md bg-white border-bottom" aria-label="Main navigation">
            <div class="container py-2">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="ph-logo-mark">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M3 5.5C3 4.67 3.67 4 4.5 4H11v15H4.5A1.5 1.5 0 0 1 3 17.5v-12Z" fill="#fff" />
                            <path d="M21 5.5c0-.83-.67-1.5-1.5-1.5H13v15h6.5a1.5 1.5 0 0 0 1.5-1.5v-12Z" fill="#fff" opacity=".85" />
                        </svg>
                    </span>
                    <span class="fs-5 fw-bold"><span class="text-scholarly">Padhai</span><span class="text-saffron">Hub</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Courses" asp-action="Index">Explore</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a></li>
                        @if (User.IsInRole("Member"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Member" asp-action="Index">My learning</a></li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin panel</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-md-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                @if (User.IsInRole("Member"))
                                {
                                    <a class="nav-link" asp-area="" asp-controller="Member" asp-action="Profile">Hi, @User.Identity.Name</a>
                                }
                                else
                                {
                                    <span class="nav-link">Hi, @User.Identity.Name</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-accent btn-sm ms-md-2" asp-area="" asp-controller="Account" asp-action="Register">Join free</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-5">
        <div class="container py-5">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <h2 class="h5 fw-bold text-white mb-2">PadhaiHub</h2>
                    <p class="text-white-50 mb-0">Open, practical learning for every curious mind.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h3 class="h6 text-warning text-uppercase mb-3">Learn</h3>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a class="footer-link" asp-area="" asp-controller="Courses" asp-action="Index">Browse courses</a></li>
                        <li class="mb-2"><a class="footer-link" asp-area="" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="mb-2"><a class="footer-link" asp-area="" asp-controller="Home" asp-action="About" asp-fragment="faq">FAQ</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h3 class="h6 text-warning text-uppercase mb-3">Support</h3>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a class="footer-link" asp-area="" asp-controller="Home" asp-action="About" asp-fragment="contact">Contact us</a></li>
                        <li class="mb-2"><a class="footer-link" href="mailto:support@padhaihub.com">Email support</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h3 class="h6 text-warning text-uppercase mb-3">Account</h3>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a class="footer-link" asp-area="" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="mb-2"><a class="footer-link" asp-area="" asp-controller="Account" asp-action="Register">Join free</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h3 class="h6 text-warning text-uppercase mb-3">Legal</h3>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a class="footer-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        <li class="mb-2"><a class="footer-link" asp-area="" asp-controller="Home" asp-action="Terms">Terms</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="d-flex flex-column flex-sm-row justify-content-between text-white-50 small gap-1">
                <span>&copy; @DateTime.Now.Year PadhaiHub</span>
                <span>Built with ASP.NET Core MVC</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>